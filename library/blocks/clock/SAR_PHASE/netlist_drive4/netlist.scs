simulator lang=spectre
// MOS D G S B; Spectre W = CDF wf = total width; CDF w = W/nf.
include "../../../../support/standard_cells/INVD1BWP7T/netlist/netlist.scs"
include "../../../logic/SAR_DFFR/netlist/netlist.scs"
include "../../../logic/SAR_DFFS/netlist/netlist.scs"
include "../../../logic/SAR_DRIVE/netlist/netlist.scs"
subckt SAR_PHASE (Clks Sample VDD VSS)
Mp_charge (PorRamp VSS VDD VDD) pch w=0.36u l=5u nf=1 m=1
C_por (PorRamp VSS) capacitor c=200f
I_por0 (PorRamp Por VDD VSS) INVD1BWP7T
I_por1 (Por PorN VDD VSS) INVD1BWP7T
I_clk0 (Clks ClksB VDD VSS) INVD1BWP7T
Mn_clock_slew (Clock ClksB VSS VSS) nch w=0.5u l=0.72u nf=1 m=1
Mp_clock_slew (Clock ClksB VDD VDD) pch w=1u l=0.72u nf=1 m=1
C_clock_slew (Clock VSS) capacitor c=20f
I_ring0 (R4 Clock PorN R0 VDD VSS) SAR_DFFR
I_ring1 (R0 Clock PorN R1 VDD VSS) SAR_DFFR
I_ring2 (R1 Clock PorN R2 VDD VSS) SAR_DFFR
I_ring3 (R2 Clock PorN R3 VDD VSS) SAR_DFFR
I_ring4 (R3 Clock PorN R4 VDD VSS) SAR_DFFS
I_buffer0 (R0 SampleN0 VDD VSS) SAR_DRIVE scale=1
I_buffer1 (SampleN0 SampleN1 VDD VSS) SAR_DRIVE scale=4
I_buffer2 (SampleN1 SampleN2 VDD VSS) SAR_DRIVE scale=16
I_buffer3 (SampleN2 SampleN3 VDD VSS) SAR_DRIVE scale=64
I_buffer4 (SampleN3 SampleN4 VDD VSS) SAR_DRIVE scale=512
I_final0 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final1 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final2 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final3 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final4 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final5 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final6 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
I_final7 (SampleN4 Sample VDD VSS) SAR_DRIVE scale=512
ends SAR_PHASE
