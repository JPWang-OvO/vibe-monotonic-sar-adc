{
  "schema_version": 1,
  "id": "rc_response",
  "testbench": "library/testbenches/blocks/rc/tb_RC_response/spectre/netlist.scs",
  "process": null,
  "conditions": [
    {
      "id": "nominal",
      "tokens": {},
      "cell_views": {},
      "enrichment": false
    }
  ],
  "simulator": {
    "arguments": [
      "+aps"
    ],
    "threads": 8,
    "timeout_s": 300,
    "analyses": "AC 1 MHz–1 GHz; transient 8 ns",
    "precision": {
      "reltol": 1e-05,
      "vabstol_v": 1e-07,
      "iabstol_a": 1e-12,
      "errpreset": "conservative"
    }
  },
  "measurement": {
    "kind": "rc_response",
    "resistance_ohm": 1000,
    "capacitance_f": 1e-12,
    "delay_s": 1e-09,
    "rise_s": 1e-11,
    "sample_times_s": [
      2e-09,
      3e-09,
      6e-09
    ]
  },
  "criteria": {
    "ac_max_complex_error_v": {
      "max": 0.001,
      "unit": "V"
    },
    "tran_max_error_v": {
      "max": 0.001,
      "unit": "V"
    }
  }
}
